# ── LLM Provider ───────────────────────────────────────────────────────────────
# Choose "anthropic" or "openai"
LLM_PROVIDER=anthropic

# ── API Keys ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # Only needed if LLM_PROVIDER=openai

# ── Model overrides (optional) ──────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# ── Generation params ───────────────────────────────────────────────────────────
TEMPERATURE=0.7
MAX_TOKENS=8192

# ── Reliability ─────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_WAIT_MIN=1.0
RETRY_WAIT_MAX=8.0

# ── Web Search (optional but recommended) ───────────────────────────────────────
# Set either key to enable live web grounding in the Research Agent.
# Tavily is preferred — it indexes Reddit and HN deeply and is designed for LLM use.
# Sign up free: https://tavily.com  |  https://brave.com/search/api/
#
# When set, the Research Agent runs 5 queries before its main LLM call:
#   - 2 broad signal queries
#   - 1 market/business query
#   - 1 Reddit community query  (site:reddit.com)
#   - 1 Hacker News query       (site:news.ycombinator.com)
#
TAVILY_API_KEY=tvly-...
BRAVE_API_KEY=BSA...

# ── Cache ───────────────────────────────────────────────────────────────────────
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ── Topic matching ───────────────────────────────────────────────────────────────
# "jaccard"    — fast, no API cost, weaker on synonym-heavy headlines (default)
# "embeddings" — semantic matching via OpenAI text-embedding-3-small (~$0.02/1M tokens)
#                requires OPENAI_API_KEY; falls back to jaccard if unavailable
SIMILARITY_METHOD=jaccard

# ── History ─────────────────────────────────────────────────────────────────────
# Snapshots older than this are deleted on startup. Set to 0 to keep forever.
HISTORY_RETENTION_DAYS=90
# Minimum hours between two runs before delta is computed. Same-day comparisons show
# LLM variance, not real trend movement — 24h is the minimum meaningful window.
DELTA_MIN_GAP_HOURS=24

# ── Storage ─────────────────────────────────────────────────────────────────────
# Default: history.db in the project root. In Docker, set to /data/history.db
# HISTORY_DB_PATH=history.db

# ── App ─────────────────────────────────────────────────────────────────────────
DEBUG=false
