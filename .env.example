# ── LLM Provider ───────────────────────────────────────────────────────────────
# Choose "anthropic" or "openai"
LLM_PROVIDER=anthropic

# ── API Keys ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # Only needed if LLM_PROVIDER=openai

# ── Model overrides (optional) ──────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# ── Generation params ───────────────────────────────────────────────────────────
TEMPERATURE=0.7
MAX_TOKENS=8192

# ── Reliability ─────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_WAIT_MIN=1.0
RETRY_WAIT_MAX=8.0

# ── Web Search ──────────────────────────────────────────────────────────────────
# At least one key is required for live results. Without either, the LLM falls
# back to its training knowledge and results will be stale.
#
# Brave Search — recommended starting point
#   Free tier: 2,000 queries/month (~150 runs)
#   Sign up: https://brave.com/search/api/
BRAVE_API_KEY=BSA...
#
# Tavily — alternative with deeper Reddit/HN indexing
#   Free tier: 1,000 credits/month (~70 runs)
#   Sign up: https://tavily.com
#   If both keys are set, Tavily runs first and automatically falls back to Brave
#   when its credits are exhausted.
TAVILY_API_KEY=tvly-...

# ── Cache ───────────────────────────────────────────────────────────────────────
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ── Topic matching ───────────────────────────────────────────────────────────────
# "jaccard"    — fast, no API cost, weaker on synonym-heavy headlines (default)
# "embeddings" — semantic matching via OpenAI text-embedding-3-small (~$0.02/1M tokens)
#                requires OPENAI_API_KEY; falls back to jaccard if unavailable
SIMILARITY_METHOD=jaccard

# ── History ─────────────────────────────────────────────────────────────────────
# Snapshots older than this are deleted on startup. Set to 0 to keep forever.
HISTORY_RETENTION_DAYS=90
# Minimum hours between two runs before delta is computed. Same-day comparisons show
# LLM variance, not real trend movement — 24h is the minimum meaningful window.
DELTA_MIN_GAP_HOURS=24

# ── Storage ─────────────────────────────────────────────────────────────────────
# Default: history.db in the project root. In Docker, set to /data/history.db
# HISTORY_DB_PATH=history.db

# ── Real Engagement APIs (all optional) ─────────────────────────────────────────
# GitHub Search — adds repo/issue signals with star and reaction counts.
# Without a token: 60 req/hr (unauthenticated). With: 5 000 req/hr.
# Create a Personal Access Token (no special scopes needed) at:
#   https://github.com/settings/tokens
# GITHUB_TOKEN=github_pat_...

# Reddit OAuth — enables direct subreddit search with upvote/comment engagement scores.
# Without credentials falls back to web-search Reddit results.
# Create an app at https://www.reddit.com/prefs/apps (script type, redirect = http://localhost)
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...

# ── App ─────────────────────────────────────────────────────────────────────────
DEBUG=false
